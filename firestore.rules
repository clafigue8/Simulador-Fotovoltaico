rules_version = '2';
// Reglas de seguridad de Firestore. Se pegan en la consola de Firebase → Firestore → Reglas,
// cambiando CORREO_ADMIN por el correo de Google de la administradora.
// - Cualquiera puede ENVIAR una opinión con el formato correcto.
// - Cualquiera puede LEER los comentarios publicados (sin correos).
// - Solo la administradora puede leer los mensajes completos, editarlos, moverlos y borrarlos.
// - La configuración del sitio la lee cualquiera y solo la cambia la administradora.
// - Las visitas se registran de forma anónima y solo las lee la administradora.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['CORREO_ADMIN'];
    }
    match /opiniones/{id} {
      allow create: if request.resource.data.keys().hasOnly(['tipo', 'seccion', 'estrellas', 'mensaje', 'nombre', 'correo', 'idioma', 'estado', 'fecha'])
        && request.resource.data.tipo in ['opinion', 'sugerencia', 'error', 'pregunta']
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() >= 4 && request.resource.data.mensaje.size() <= 2000
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80
        && request.resource.data.correo is string && request.resource.data.correo.size() <= 120
        && request.resource.data.estrellas is int && request.resource.data.estrellas >= 0 && request.resource.data.estrellas <= 5
        && request.resource.data.estado == 'nuevo'
        && request.resource.data.fecha == request.time;
      allow read, update, delete: if isAdmin();
    }
    match /publicas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{doc} {
      allow read, write: if isAdmin();
    }
    // Configuración del sitio (datos técnicos, equipos, textos, colores): todos la leen, solo la administradora la cambia
    match /sitio/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Visitas anónimas: cualquiera registra una visita con el formato correcto; solo la administradora las lee
    match /visitas/{id} {
      allow create: if request.resource.data.keys().hasOnly(['seccion', 'disp', 'ses', 'lang', 'fecha'])
        && request.resource.data.seccion is string && request.resource.data.seccion.size() <= 20
        && request.resource.data.disp in ['movil', 'escritorio']
        && request.resource.data.ses is string && request.resource.data.ses.size() <= 24
        && request.resource.data.lang in ['es', 'en']
        && request.resource.data.fecha == request.time;
      allow read, delete: if isAdmin();
    }
  }
}
